# Required for AI-powered analysis
OPENAI_API_KEY=sk-your-openai-api-key

# Required for NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret

# GitHub OAuth app credentials (https://github.com/settings/developers)
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Optional — server-side GitHub token for unauthenticated users
# Also used by `npm run push:github` to create and push the repo
GITHUB_TOKEN=ghp_your-github-token

# Optional — for non-interactive Vercel deploy (`npm run deploy`)
VERCEL_TOKEN=your-vercel-token

# Required in production — your deployed URL
AUTH_URL=https://your-app.vercel.app
